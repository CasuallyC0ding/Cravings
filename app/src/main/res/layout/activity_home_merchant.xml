<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".baseActivities.HomeMerchantActivity">

    <!-- Background image -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/food_pattern_bg_dark"
        android:contentDescription="Background" />

    <!-- Dark gradient overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dark_gradient_overlay" />

    <!-- Foreground layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/roleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MERCHANT"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFD180"
                android:layout_weight="1"
                android:fontFamily="@font/dancing_script_semibold" />

            <ImageView
                android:id="@+id/profileButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="end"
                android:src="@drawable/ic_profile_placeholder"
                android:background="@drawable/circle_background"
                android:clipToOutline="true"
                android:contentDescription="Profile" />
        </LinearLayout>

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to Your Merchant Dashboard!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/dancing_script_semibold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Info Card -->
        <LinearLayout
            android:id="@+id/profileSection"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:elevation="8dp"
            android:gravity="center_horizontal"
            android:layout_margin="16dp"
            android:clipToOutline="true"
            android:background="@drawable/rounded_card">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_profile_placeholder"
                android:background="@drawable/circle_background"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:contentDescription="Profile Image"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/merchantNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merchant Name"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/dancing_script_semibold" />

            <TextView
                android:id="@+id/shopNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop Name"
                android:textSize="18sp"
                android:textColor="#FFD180"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/dancing_script_regular" />

            <TextView
                android:id="@+id/phoneText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/dancing_script_regular" />
        </LinearLayout>

        <!-- Optional Action Button -->
        <Button
            android:id="@+id/manageProductsBtn"
            android:text="Manage Products"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_orange_gradient"
            android:elevation="6dp"
            android:padding="14dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</RelativeLayout>
