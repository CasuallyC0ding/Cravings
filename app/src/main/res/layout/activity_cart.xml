<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#28A745"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Order Summary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Shop Name -->
        <TextView
            android:id="@+id/shopNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shop Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#28A745"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:scrollbars="vertical" />

        <!-- Bottom Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#FFFFFF"
            android:elevation="8dp">

            <!-- Pickup method -->
            <LinearLayout
                android:id="@+id/pickupSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pickup Method"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#333" />

                <CheckBox
                    android:id="@+id/checkShopPickup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shop Pickup"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/checkDelivery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Delivery Section (hidden) -->
            <LinearLayout
                android:id="@+id/deliverySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone"
                android:background="#F8F8F8">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Location"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnCurrentLocation"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="Use Current Location" />

                <Button
                    android:id="@+id/btnSelectLocation"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="Select From Map"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/selectedLocationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No location selected"
                    android:textColor="#333"
                    android:textSize="14sp"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <!-- Delivery cost section (hidden) -->
            <LinearLayout
                android:id="@+id/deliveryCostSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtItemsTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Items Total: EGP 0.00"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtDeliveryFee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Delivery Fee: EGP 0.00"
                    android:textSize="15sp"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/txtFinalTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Final Total: EGP 0.00"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:paddingTop="4dp" />
            </LinearLayout>

            <!-- Clear & Proceed -->
            <Button
                android:id="@+id/clearCartButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Clear Cart"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="@android:color/holo_red_light"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/proceedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Proceed to Checkout"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:backgroundTint="#28A745"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
