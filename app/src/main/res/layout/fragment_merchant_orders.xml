<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/transparent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Orders Screen"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/dancing_script_semibold" />

    <!-- You can add your orders RecyclerView here later -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incoming orders will appear here"
        android:textSize="18sp"
        android:textColor="#FFD180"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/dancing_script_regular" />

</LinearLayout>