<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cravings"
        tools:targetApi="31">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_API_KEY_HERE" />

        <!-- FCM Default Channel -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="orders_channel" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Activities -->
        <activity android:name=".baseActivities.VoipActivity" android:exported="false" />
        <activity android:name=".delivery.DeliveryOrdersActivity" android:exported="false" />
        <activity android:name=".delivery.DeliveryShopsActivity" android:exported="false" />
        <activity android:name=".baseActivities.CheckoutActivity" android:exported="false" />
        <activity android:name=".baseActivities.MapPickerActivity" android:exported="false" />
        <activity android:name=".baseActivities.AddProductActivity" android:exported="false" />
        <activity android:name=".baseActivities.ProductActivity" android:exported="false" />
        <activity android:name=".baseActivities.ShopProductsActivity" android:exported="false" />
        <activity android:name=".baseActivities.CartActivity" android:exported="false" />
        <activity android:name=".ShopsActivity" android:exported="false" />
        <activity android:name=".menu" android:exported="false" />

        <!-- Customer Home - handles notification when app is running -->
        <activity
            android:name=".baseActivities.HomeCustomerActivity"
            android:launchMode="singleTask"
            android:exported="true" />

        <!-- Merchant Home - handles notification when app is running -->
        <activity
            android:name=".baseActivities.HomeMerchantActivity"
            android:launchMode="singleTask"
            android:exported="true" />

        <activity android:name=".baseActivities.LoginActivity"
            android:exported="false"
            android:label="Login"
            android:theme="@style/Theme.Cravings" />
        <activity android:name=".baseActivities.SignupActivity"
            android:exported="false"
            android:label="Register" />
        <activity android:name=".baseActivities.ProfileActivity"
            android:exported="false"
            android:label="Cravings Home" />
        <activity android:name=".baseActivities.RoleSelectionActivity"
            android:exported="false"
            android:label="Main" />

        <!-- Edit Product - handles stock alert notification -->
        <activity
            android:name=".baseActivities.EditProductActivity"
            android:launchMode="singleTask"
            android:exported="true" />

        <!-- NEW: Notification Handler Activity - routes notifications when app is killed -->
        <activity
            android:name=".baseActivities.NotificationHandlerActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:noHistory="true"
            android:excludeFromRecents="true" />

        <!-- Launcher Activity -->
        <activity
            android:name=".baseActivities.MainActivity"
            android:exported="true"
            android:label="Cravings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Messaging Service -->
        <service
            android:name=".notifications.OrderNotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>