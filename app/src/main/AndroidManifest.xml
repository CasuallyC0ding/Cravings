<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cravings"
        tools:targetApi="31">

        <!-- Role Selection screen (main entry point) -->
        <activity
            android:name=".RoleSelectionActivity"
            android:exported="true"
            android:label="Cravings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HomeCustomerActivity"
            android:exported="false" />
        <activity
            android:name=".HomeMerchantActivity"
            android:exported="false" /> <!-- Role Selection screen (main entry point) -->
        <!-- Login screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="Login"
            android:theme="@style/Theme.Cravings" />

        <!-- Registration screen -->
        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:label="Register" />

        <!-- Home screen -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="Cravings Home" />

        <!-- Optional: MainActivity (if still used for testing) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="Main" />

    </application>

</manifest>
